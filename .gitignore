local.properties

# Auto-generated by Android Studio / `updateDaemonJvm` — pins the Gradle
# daemon to whatever JDK is on the machine that generated it (confirmed:
# toolchainVersion matched this machine's Android-Studio-bundled JDK 25
# exactly). Committing this would force CI (which intentionally uses JDK
# 21 — see android-ci.yml) to fight with it. Machine-specific, not a
# project setting.
gradle/gradle-daemon-jvm.properties

# Firebase — never commit real project config. See CLAUDE.md's Firebase
# section for why and how to get your own.
app/google-services.json

# Release signing — the actual key that gets used for every Play Store
# update from here on. Losing it is recoverable (Play App Signing lets
# Google reset your upload key), but it should never be in git history
# regardless. See CLAUDE.md's "Release signing" section for what's here
# and how to regenerate it if needed.
keystore/
keystore.properties

# Build outputs
*.apk
*.aab
